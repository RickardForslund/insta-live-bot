# HTTP server. Use 0.0.0.0 so a tunnel such as ngrok can reach the webhook.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Meta app credentials. Leave the secret empty until you connect a real app.
# Webhook POSTs are rejected without META_APP_SECRET. The local simulator does not need it.
META_APP_SECRET=
META_VERIFY_TOKEN=dev-verify-token

# Professional Instagram account the app acts as.
# IG_ACCESS_TOKEN is a user token (Instagram Login) or a Page token (Facebook Login).
IG_USER_ID=
IG_ACCESS_TOKEN=

# Graph API. Instagram Login uses graph.instagram.com.
# Facebook Login for Business often uses https://graph.facebook.com and the linked Page id.
GRAPH_API_VERSION=v25.0
GRAPH_API_BASE_URL=https://graph.instagram.com

# One private reply (DM) per live comment. Only works while the broadcast is still live.
# Off by default so a fresh checkout never calls Meta.
PRIVATE_REPLIES_ENABLED=false

# Fake incoming comments at POST /dev/simulate and the form at GET /dev.
# Defaults to on outside production. Set false before exposing the port publicly.
SIMULATOR_ENABLED=true

# Leading token that marks a chat command. Example: !fråga Vad är klockan?
COMMAND_PREFIX=!

# How long a card stays on the OBS overlay, in milliseconds. 0 keeps it until the next one.
OVERLAY_HIDE_MS=12000

# Optional OpenAI-compatible chat API. When LLM_API_KEY is empty the stub answer is used.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Leave empty to use the built-in Swedish system prompt.
LLM_SYSTEM_PROMPT=
